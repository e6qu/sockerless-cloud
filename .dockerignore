.DS_Store

# Release simulator images build the per-cloud binaries. Test harnesses,
# generated test binaries, Terraform caches, and the console sources are not
# part of the runtime image source context; the committed simulator-<cloud>/dist
# bundles are, since the binaries embed them.
**/sdk-tests
**/cli-tests
**/terraform-tests
**/*.test
ui

# Locally built simulator binaries, including the per-suite ones each test
# suite builds so concurrent suites cannot overwrite each other.
simulator-aws/simulator-aws
simulator-gcp/simulator-gcp
simulator-azure/simulator-azure
simulator-aws/.build
simulator-gcp/.build
simulator-azure/.build

# Terraform and local runtime artifacts can appear under test directories.
**/.terraform
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/.stack-pids

# Never ship VCS state, package caches, or local Go build caches into a context.
.git
**/node_modules
.gocache
.turbo
**/.turbo
