{
	admin {$SOCKERLESS_HTTPS_GATEWAY_ADMIN:localhost:28443}
	auto_https disable_redirects
	skip_install_trust
	# Each gateway starts on an empty data directory, so there is nothing stale to
	# check or clean, and the clean-up must not run: started alongside the first
	# issuance, it deletes a certificate whose key is still being written.
	storage_check off
	storage_clean_interval off
	# Log each certificate entering the cache: the gateway serves a name only
	# from then on, so a client waits on this entry before its first handshake.
	log certificate_cache {
		output stderr
		format json
		include tls.cache
		level DEBUG
	}
}

# SOCKERLESS_HTTPS_GATEWAY_LISTEN picks how the sites listen: ports binds the
# site address's port on every interface; fds serves sockets a test harness
# holds and hands down, TCP at descriptor 3 and UDP for HTTP/3 at descriptor 4,
# with the admin endpoint at SOCKERLESS_HTTPS_GATEWAY_ADMIN=fd/5.
(listen-ports) {
}

(listen-fds) {
	bind fd/3 {
		protocols h1 h2
	}
	bind fdgram/4 {
		protocols h3
	}
}

# The second name is the Amazon ECR private-registry login server,
# <aws_account_id>.dkr.ecr.<region>.amazonaws.com, at this gateway's coordinate:
# a container engine reaches a registry by the host in the image reference, so
# the Docker Registry HTTP API v2 data plane needs a name shaped like one and a
# certificate issued for it. The third is an Amazon S3 bucket's virtual-hosted
# name, <bucket>.<endpoint host>, which an SDK given this endpoint addresses.
https://aws.sockerless.localhost:{$SOCKERLESS_HTTPS_GATEWAY_PORT:8443},
https://*.dkr.ecr.aws.sockerless.localhost:{$SOCKERLESS_HTTPS_GATEWAY_PORT:8443},
https://*.aws.sockerless.localhost:{$SOCKERLESS_HTTPS_GATEWAY_PORT:8443} {
	import listen-{$SOCKERLESS_HTTPS_GATEWAY_LISTEN:ports}
	tls internal
	reverse_proxy 127.0.0.1:{$SOCKERLESS_AWS_SIM_PORT:4566} {
		header_up X-Forwarded-Proto https
	}
}

# The second name is the Artifact Registry Docker endpoint,
# <location>-docker.pkg.dev, at this gateway's coordinate: a container engine
# reaches a registry by the host in the image reference, so the Docker Registry
# HTTP API v2 data plane needs a name shaped like one and a certificate issued
# for it.
https://gcp.sockerless.localhost:{$SOCKERLESS_HTTPS_GATEWAY_PORT:8443},
https://*.pkg.gcp.sockerless.localhost:{$SOCKERLESS_HTTPS_GATEWAY_PORT:8443} {
	import listen-{$SOCKERLESS_HTTPS_GATEWAY_LISTEN:ports}
	tls internal
	reverse_proxy 127.0.0.1:{$SOCKERLESS_GCP_SIM_PORT:4567} {
		header_up X-Forwarded-Proto https
	}
}

# A client given https://localhost addresses an Amazon S3 bucket as
# <bucket>.localhost.
https://localhost:{$SOCKERLESS_HTTPS_GATEWAY_PORT:8443},
https://*.localhost:{$SOCKERLESS_HTTPS_GATEWAY_PORT:8443} {
	import listen-{$SOCKERLESS_HTTPS_GATEWAY_LISTEN:ports}
	tls internal
	reverse_proxy 127.0.0.1:{$SOCKERLESS_HTTPS_GATEWAY_DEFAULT_SIM_PORT:4566} {
		header_up X-Forwarded-Proto https
	}
}

